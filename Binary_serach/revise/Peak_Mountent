class Peak_Mountent{
  public static int peak_Mountent(int arr[],int target){
      int right=arr.length-1;
      int left=0;
      int mid=0;
      int ans=-1;
      while(left<=right){
        mid=left+(right-left)/2;
        if(arr[mid]<arr[mid+1]){
          left=mid+1;
        }else{
          ans=mid;
          right=mid-1;
        }
      }return ans;
  }
  public static void main(String arg[]){
      int arr[]={1,3,5,4,2};
    int ans=peak_Mountent(arr);
    System.out.println("the mountain array ans is =>"+ans);
  }
}